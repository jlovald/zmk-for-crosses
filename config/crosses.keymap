#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT";
            #binding-cells = <2>;

            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";

            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ───────────── Layer 0 (Base) ───────────── */
        layer_0 {
            bindings = <
&kp ESC  &kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I    &kp O    &kp P    &kp BSLH
&kp TAB  &kp A    &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp K    &kp L    &kp ENTER &kp APOS
&kp LCTL &lt 3 Z   &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA &kp DOT  &lt 3 SLASH &kp ESC
                    &kp LCTRL &kp LEFT_SHIFT &lt 1 SPACE &lt 2 ENTER &kp BACKSPACE &kp RIGHT_ALT
            >;
        };

        /* ───────────── Layer 1 (Numbers / F-keys) ───────────── */
        layer_1 {
            bindings = <
&none &kp N1 &kp N2 &kp N3 &kp N4 &kp N5    &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &none
&none &kp N6 &kp N7 &kp N8 &kp N9 &kp N0    &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &none
&none &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH  &kp F11 &kp F12 &none &none &none &none
                    &kp LCTRL &kp LEFT_SHIFT &trans &kp ENTER &kp BACKSPACE &kp RIGHT_WIN
            >;
        };

        /* ───────────── Layer 2 (Shifted / Arrows) ───────────── */
        layer_2 {
            bindings = <
&none &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(N4) &kp LS(N5)   &none &none &none &none &none &none
&none &kp LS(N6) &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0)   &kp UP_ARROW &none &none &none &none &none
&none &kp LS(MINUS) &kp LS(EQUAL) &kp LS(LBKT) &kp LS(RBKT) &kp LS(BSLH) &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &none &none &none
                    &kp LCTRL &kp LEFT_SHIFT &kp SPACE &trans &kp BACKSPACE &kp RIGHT_ALT
            >;
        };

        /* ───────────── Layer 3 (BT + Mouse) ───────────── */
        layer_3 {
            bindings = <
&none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &none   &none &none &none &none &none &none
&none &none        &none        &none        &none        &none   &none &none &none &none &none &none
&trans &none       &none        &none        &none        &none   &none &none &none &none &none &trans
                    &mkp MCLK &mkp LCLK &mkp RCLK &mkp RCLK &mkp LCLK &mkp MCLK
            >;
        };
    };
};
