#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        tap_dance_modkeys: tap_dance_modkeys {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_MODKEYS";
            #binding-cells = <0>;
            bindings = <&mo 5>, <&kp LEFT_WIN>, <&kp LEFT_WIN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        &trackball_other_listener {
                rel_x = <&kp LEFT &kp RIGHT>;   // LEFT/RIGHT arrow
                rel_y = <&kp UP &kp DOWN>;      // UP/DOWN arrow
            };
        layer_0 {
            bindings = <
&kp TAB             &kp Q         &kp W        &kp E        &kp R            &kp T          &kp Y  &kp U  &kp I      &kp O    &kp P          &kp BSLH
&kp LCTRL           &kp A         &kp S        &kp D        &kp F            &kp G          &kp H  &kp J  &kp K      &kp L    &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT      &lt 3 Z       &kp X        &kp C        &kp V            &kp B          &kp N  &kp M  &kp COMMA  &kp DOT  &lt 3 SLASH    &mt RIGHT_ALT ESCAPE
&tap_dance_modkeys  &kp LEFT_ALT  &lt 4 SPACE  &lt 5 ENTER  &lt 2 BACKSPACE  &lt 1 SPACE
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &none    &none  &kp F1  &kp F2   &kp F3   &kp F4   &none
&trans  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &none    &none  &kp F5  &kp F6   &kp F7   &kp F8   &none
&trans  &kp NUMBER_9  &kp NUMBER_0  &none         &none         &none    &none  &kp F9  &kp F10  &kp F11  &kp F12  &none
&none   &trans        &none         &none         &none         &none
            >;
        };

        layer_2 {
            bindings = <
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)  &none        &none         &kp F1     &kp F2    &kp F3   &kp F4   &none
&trans  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)     &kp LS(N8)  &none        &kp UP_ARROW  &kp RIGHT  &kp HOME  &kp F7   &kp F8   &none
&trans  &kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)  &none       &none        &kp DOWN      &kp LEFT   &kp END   &kp F11  &kp F12  &none
&none   &trans      &none       &none          &none       &kp SPACE
            >;
        };

        layer_3 {
            bindings = <
&none      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none      &bt BT_CLR    &bt BT_CLR  &none  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none      &none         &none         &none         &none      &none         &none       &none  &none         &none         &none         &none
&none      &none         &none         &none         &none      &none         &none       &none  &none         &none         &none         &none
&mkp MCLK  &mkp LCLK     &mkp RCLK     &mkp RCLK     &mkp LCLK  &mkp MCLK
            >;
        };

        mouseLayer {
            bindings = <
&trans  &trans  &trans  &trans    &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans    &mkp MB4  &mkp MB5    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans    &trans    &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &mkp MB1  &mkp MB2  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans            &trans             &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp PLUS   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp UNDER  &kp EQUAL  &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
